{
  "name": "shadow-duel",
  "version": "1.0.0",
  "description": "Um jogo de cartas digital inspirado na era clássica de Yu-Gi-Oh! Duela contra o bot, construa seu deck e reduza os Pontos de Vida do oponente a zero!",
  "license": "MIT",
  "author": "Ratcicle",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:app": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.app.json",
    "typecheck:node": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.node.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:node",
    "typecheck:watch:app": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.app.json --watch",
    "typecheck:watch:node": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.node.json --watch",
    "test": "tsx scripts/run_tests.ts",
    "audit:chain": "tsx scripts/audit_chain_metadata.ts",
    "validate:actions": "tsx scripts/validate_action_catalog.ts",
    "generate:actions": "tsx scripts/generate_action_catalog_doc.ts",
    "check:actions-doc": "tsx scripts/generate_action_catalog_doc.ts --check",
    "audit:typescript-escapes": "tsx scripts/audit_typescript_escapes.ts",
    "replay": "tsx scripts/replay_duel.ts",
    "test:bot-smoke": "node --import=tsx --import=./scripts/register_node_asset_loader.ts scripts/run_bot_arena_smoke.ts",
    "verify:migration-digest": "tsx scripts/verify_migration_digest.ts",
    "check": "npm run typecheck && npm run audit:typescript-escapes && npm test && npm run audit:chain && npm run validate:actions && npm run check:actions-doc && npm run verify:migration-digest && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.2"
  },
  "dependencies": {
    "@tabler/icons": "^3.45.0",
    "pixi.js": "^8.19.0"
  }
}
